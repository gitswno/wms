#!/data/data/com.termux/files/usr/bin/env python3
# 在/storage/emulated/0/Download/wms中搜索关键词并显示货位
# 用法 python ss keyword
# 支持分支条件，例: python ss "keyword1|keyword2"
# 支持多文件搜索

import sys
import re
import os

def main():
    if len(sys.argv) < 2:
        print("用法: {} <keyword>".format(sys.argv[0]))
        print("示例: {} 好|坏".format(sys.argv[0]))
        print("示例: {} 猫".format(sys.argv[0]))
        sys.exit(1)
    
    keyword = sys.argv[1]
    print(f"接收到的参数: {keyword}")
    
    # ========== 配置多个文件路径 ==========
    file_paths = [
        "/storage/emulated/0/Download/wms/wmsd东院仓库库存查询",
        "/storage/emulated/0/Download/wms/wmsx西院仓库库存查询",
        "/storage/emulated/0/Download/wms/wuvo西院无着入库",
        # 添加更多文件路径...
    ]
    # =====================================
    
    # 颜色定义
    RED = '\033[31m'
    GREEN = '\033[32m'
    YELLOW = '\033[33m'
    BLUE = '\033[34m'
    WHITE = '\033[37m'
    NC = '\033[0m'
    
    # 构建正则表达式
    if '|' in keyword:
        escaped_keywords = [re.escape(k) for k in keyword.split('|')]
        pattern = re.compile('|'.join(escaped_keywords), re.IGNORECASE)
    else:
        pattern = re.compile(re.escape(keyword), re.IGNORECASE)
    
    print(f"\n搜索关键词: {keyword}")
    print(f"搜索文件数量: {len(file_paths)}")
    print("=" * 50)
    
    total_found = 0
    files_with_matches = []
    
    for file_path in file_paths:
        try:
            with open(file_path, 'r', encoding='utf-8') as f:
                lines = f.readlines()
        except FileNotFoundError:
            print(f"{RED}警告{NC}: 找不到文件 {file_path}")
            print("-" * 50)
            continue
        except Exception as e:
            print(f"{RED}错误{NC}: 无法读取文件 {file_path}: {e}")
            print("-" * 50)
            continue
        
        file_name = os.path.basename(file_path)
        found_in_file = False
        file_match_count = 0
        
        for line_num, line in enumerate(lines, 1):
            if pattern.search(line):
                if not found_in_file:
                    print(f"\n{BLUE}▶ 文件: {file_path}{NC}")
                    print("-" * 50)
                    found_in_file = True
                
                file_match_count += 1
                total_found += 1
                
                # 高亮关键词
                def replace_match(match):
                    return f"{RED}{match.group(0)}{NC}"
                
                highlighted_line = pattern.sub(replace_match, line)
                print(f"【关键字行】 第 {GREEN}{line_num}{NC} 行: {highlighted_line}", end='')
                
                if ':' in line:
                    print("  └─ 该行自身包含冒号，无需往上查找。")
                else:
                    货位行 = None
                    货位行号 = None
                    for i in range(line_num - 1, 0, -1):
                        if ':' in lines[i-1]:
                            货位行 = lines[i-1].strip()
                            货位行号 = i
                            break
                    
                    if 货位行:
                        print(f"【货位】 第 {货位行号} 行: {WHITE}{货位行}{NC}")
                    else:
                        print("  └─ 往前搜索到第1行，未发现包含冒号的行。")
                
                print()
        
        if found_in_file:
            files_with_matches.append(file_name)
            print(f"{GREEN}✓ 文件 {file_name} 中找到 {file_match_count} 处匹配{NC}")
        
        print("=" * 50)
    
    # 汇总信息
    print(f"\n{YELLOW}========== 搜索汇总 =========={NC}")
    print(f"总匹配数: {GREEN}{total_found}{NC} 处")
    print(f"有匹配的文件数: {GREEN}{len(files_with_matches)}/{len(file_paths)}{NC}")
    if files_with_matches:
        print(f"有匹配的文件: {', '.join(files_with_matches)}")
    
    if total_found == 0:
        print(f"\n{RED}未找到包含关键词 '{keyword}' 的内容{NC}")

if __name__ == "__main__":
    main()
